# ==============================================================================
# Environment Variables for Kailash Portfolio
# ==============================================================================

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# Résumé Notification Email (SMTP)
# ------------------------------------------------------------------------------
# If using Gmail:
# 1. Turn on 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character App Password (select App: 'Mail' or 'Other'):
#    https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address in SMTP_USER and the 16-character App Password in SMTP_PASSWORD
# 4. Use SMTP_HOST=smtp.gmail.com and SMTP_PORT=465

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ambadipudikailash@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Destination email where notifications are sent (defaults to ambadipudikailash@gmail.com)
RESUME_ALERT_TO=ambadipudikailash@gmail.com

# ------------------------------------------------------------------------------
# Origin / Host Configuration (Optional)
# ------------------------------------------------------------------------------
# Set to your deployed production URL on Render
RESUME_ACCESS_ORIGIN=https://portfolio-wp5f.onrender.com

# Optional local data directory for sqlite database
# RESUME_ACCESS_DATA_DIR=.resume-access
